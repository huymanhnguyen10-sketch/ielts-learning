# SQLite database file (relative to the prisma/ folder)
DATABASE_URL="file:./dev.db"

# Optional: enables the AI tutor and AI sentence feedback.
# Create a key at https://platform.claude.com/ — leave empty to run without AI.
ANTHROPIC_API_KEY=""

# Optional: override the Claude model used by the tutor.
ANTHROPIC_MODEL="claude-opus-5-5"

# Set to "true" to seed the 12 sample phrases from the prototype (dev only).
SEED_SAMPLE_PHRASES="true"
